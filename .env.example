HOST=0.0.0.0
PORT=3000
LOG_LEVEL=INFO
RELOAD=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=room_recommendation
DB_USERNAME=postgres
DB_PASSWORD=change_me

AWS_REGION=us-east-1
# Prefer AWS profile / IAM role. Only set static keys locally if needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Verify model access and the model's embedding dimension for your AWS account.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=YOUR_BEDROCK_MODEL_ID_OR_INFERENCE_PROFILE_ARN
TEMPERATURE=0.3
MAX_TOKENS=500
TOP_K=3

CORS_ORIGINS=http://localhost:3000
